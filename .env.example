DATABASE_URL=postgres://surcast:surcast@localhost:5433/surcast
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
# Directory holding the music library (original filenames kept, subfolders
# allowed). Panel/API uploads land here too. Defaults to ./music.
# Point your FTP/SFTP server at this directory to drop files in directly —
# they are picked up by the lazy scanner when the library opens.
#MUSIC_DIR=./music
ICECAST_PUBLIC_URL=https://example.com
# info by default; use surcast_backend=debug,tower_http=debug for verbose output
RUST_LOG=surcast_backend=info,tower_http=warn
